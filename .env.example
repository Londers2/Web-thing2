DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_workspace
PORT=3001
HOST=0.0.0.0
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_NAME=Администратор
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: absolute path for uploaded images
# UPLOAD_DIR=./data/uploads
# Local Whisper is installed automatically in data/whisper on first launch
WHISPER_AUTO_INSTALL=true
LOCAL_WHISPER_MODEL=base
# Optional: custom whisper CLI instead of automatic faster-whisper installation
# LOCAL_WHISPER_EXECUTABLE=whisper
# Optional: fallback transcription with OpenAI Whisper
# OPENAI_API_KEY=your-api-key
# OPENAI_TRANSCRIBE_MODEL=whisper-1
